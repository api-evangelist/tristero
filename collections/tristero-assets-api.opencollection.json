{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tristero Assets API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List supported assets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tristero.com/v2/assets"
          },
          "docs": "Returns the list of supported assets and their current market prices and liquidity information."
        }
      ]
    }
  ],
  "bundled": true
}