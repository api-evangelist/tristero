          "name": "Get price quote",
          "request": {
            "name": "Get price quote",
            "description": {
              "content": "Returns a live price quote for a swap between two assets. Optionally computes a worked example for a specific input or output amount.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "price"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "input_asset",
                  "value": "<string>",
                  "description": "(Required) Asset you are sending (e.g. BTC)"
                },
                {
                  "disabled": false,
                  "key": "output_asset",
                  "value": "<string>",
                  "description": "(Required) Asset you want to receive (e.g. ETH)"
                },
                {
                  "disabled": false,
                  "key": "input_amount",
                  "value": "<float>",
                  "description": "If provided, compute the expected output for this input amount"
                },
                {
                  "disabled": false,
                  "key": "output_amount",
                  "value": "<float>",
                  "description": "If provided, estimate the required input to receive this output amount"
                }
              ],
              "variable": []
            },
